rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user is a teacher
    function isTeacher() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    
    // Helper function to check if user is a student
    function isStudent() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    
    // Users collection
    match /users/{userId} {
      // Allow users to read their own data or any authenticated user to read (for teacher-student relationships)
      allow read: if isAuthenticated();
      
      // Allow users to create/update their own data
      allow create: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       request.resource.data.uid == userId;
      
      // Allow users to update their own data
      // OR allow students to update teacher documents to enroll themselves
      allow update: if isAuthenticated() && (
                       // User updating their own document
                       request.auth.uid == userId ||
                       // Student enrolling with a teacher (only modifying enrolledStudents field)
                       (isStudent() && 
                        resource.data.role == 'teacher' &&
                        // Only allow changes to enrolledStudents field
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents']) &&
                        // Ensure the new array contains all old values (no removals) - handle case where field might not exist
                        (resource.data.enrolledStudents == null || 
                         request.resource.data.enrolledStudents.hasAll(resource.data.enrolledStudents)) &&
                        // Ensure the student's UID is being added
                        request.resource.data.enrolledStudents.hasAny([request.auth.uid]))
                     );
      
      allow delete: if isAuthenticated() && 
                       request.auth.uid == userId;
    }
    
    // Lessons collection
    match /lessons/{lessonId} {
      // Allow read if:
      // 1. User is authenticated (for now, we allow all authenticated users to read)
      // 2. In the future, we can restrict to: teacher owns it OR student is enrolled to the teacher
      allow read: if isAuthenticated();
      
      // Allow create if user is a teacher and sets themselves as the teacherId
      allow create: if isTeacher() && 
                       request.resource.data.teacherId == request.auth.uid;
      
      // Allow update/delete if user is the teacher who owns the lesson
      allow update: if isAuthenticated() && 
                       resource.data.teacherId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
                       resource.data.teacherId == request.auth.uid;
    }
    
    // Enrollments collection (if you have one for tracking student-teacher relationships)
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
                               resource.data.teacherId == request.auth.uid;
    }
    
    // Quizzes collection
    match /quizzes/{quizId} {
      // Allow read if user is authenticated
      allow read: if isAuthenticated();
      
      // Allow create if user is a teacher and sets themselves as the teacherId
      allow create: if isTeacher() && 
                       request.resource.data.teacherId == request.auth.uid;
      
      // Allow update/delete if user is the teacher who owns the quiz
      allow update: if isTeacher() && 
                       resource.data.teacherId == request.auth.uid;
      
      allow delete: if isTeacher() && 
                       resource.data.teacherId == request.auth.uid;
    }
    
    // Homeworks collection
    match /homeworks/{homeworkId} {
      // Allow read if user is authenticated
      allow read: if isAuthenticated();
      
      // Allow create if user is a teacher and sets themselves as the teacherId
      allow create: if isTeacher() && 
                       request.resource.data.teacherId == request.auth.uid;
      
      // Allow update/delete if user is the teacher who owns the homework
      allow update: if isTeacher() && 
                       resource.data.teacherId == request.auth.uid;
      
      allow delete: if isTeacher() && 
                       resource.data.teacherId == request.auth.uid;
    }
    
    // Quiz submissions collection
    match /quiz_submissions/{submissionId} {
      // Allow read if user is authenticated
      // Teachers can read submissions for their quizzes (check via quiz document)
      // Students can read their own submissions
      allow read: if isAuthenticated() && (
                     // Teacher reading submissions - check if quiz belongs to teacher
                     (isTeacher() && 
                      exists(/databases/$(database)/documents/quizzes/$(resource.data.quizId)) &&
                      get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.teacherId == request.auth.uid) ||
                     // Student reading their own submission
                     (isStudent() && 
                      resource.data.studentId == request.auth.uid)
                   );
      
      // Allow create if user is a student and sets themselves as the studentId
      allow create: if isStudent() && 
                       request.resource.data.studentId == request.auth.uid;
      
      // Students should not be able to update or delete their submissions
      // (quizzes are one-time submissions)
      allow update, delete: if false;
    }
  }
}

